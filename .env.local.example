# Copiar a .env.local (nunca commitear .env.local) y completar cuando exista
# el proyecto Supabase. Los tokens de Relbase NO van aca: viven encriptados en
# la tabla credenciales_relbase (uno por empresa), ver CLAUDE.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clave usada para cifrar/descifrar token_empresa y token_usuario_integrador
# antes de guardarlos/leerlos de credenciales_relbase (AES-256-GCM). Generar
# con: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Relbase API v2 (OAuth2): credenciales de la OAuth Application creada en
# Relbase > "Mis Aplicaciones". El secret nunca va al frontend ni al repo.
RELBASE_OAUTH_CLIENT_ID=
RELBASE_OAUTH_CLIENT_SECRET=
RELBASE_OAUTH_REDIRECT_URI=https://dilogic.vercel.app/api/relbase/oauth/callback

# Interruptor de la API de Relbase: v1 (por defecto) o v2. Volver a v1 no
# requiere desplegar codigo, solo cambiar esta variable.
RELBASE_API_VERSION=v2
# Emitir guias con v2 queda bloqueado hasta la prueba controlada (Paso 6).
RELBASE_V2_EMISION_HABILITADA=false
