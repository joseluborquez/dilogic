# Copiar a .env.local (nunca commitear .env.local) y completar cuando exista
# el proyecto Supabase. Los tokens de Relbase NO van aca: viven encriptados en
# la tabla credenciales_relbase (uno por empresa), ver CLAUDE.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clave usada para cifrar/descifrar token_empresa y token_usuario_integrador
# antes de guardarlos/leerlos de credenciales_relbase (AES-256-GCM). Generar
# con: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
