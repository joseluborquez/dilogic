# Copiar a .env.local (nunca commitear .env.local). Los tokens de Relbase NO
# van aca: la conexion OAuth se hace desde Empresas y queda cifrada en la
# tabla relbase_conexion, ver CLAUDE.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clave usada para cifrar/descifrar los tokens OAuth de Relbase en
# relbase_conexion (AES-256-GCM). Debe ser la misma aqui y en Vercel. Generar
# con: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Relbase API v2 (OAuth2): credenciales de la OAuth Application creada en
# Relbase > "Mis Aplicaciones". El secret nunca va al frontend ni al repo.
RELBASE_OAUTH_CLIENT_ID=
RELBASE_OAUTH_CLIENT_SECRET=
RELBASE_OAUTH_REDIRECT_URI=https://dilogic.vercel.app/api/relbase/oauth/callback
